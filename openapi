---
openapi: 3.1.0
components:
  schemas:
    Product:
      type: object
      required:
      - name
      - price
      - quantity
      properties:
        id:
          type: integer
          format: int32
        name:
          type: string
          pattern: \S
        description:
          type: string
        price:
          type: number
          format: double
          minimum: 0
        quantity:
          type: integer
          format: int32
          minimum: 0
    ProductDTO:
      type: object
      properties:
        name:
          type: string
        description:
          type: string
        price:
          type: number
          format: double
        quantity:
          type: integer
          format: int32
paths:
  /products:
    get:
      responses:
        "200":
          description: OK
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/Product"
      summary: Get All
      tags:
      - Product Resource
    post:
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/ProductDTO"
        required: true
      responses:
        "200":
          description: OK
          content:
            application/json: {}
        "400":
          description: Bad Request
      summary: Create
      tags:
      - Product Resource
  /products/bulk:
    post:
      requestBody:
        content:
          application/json:
            schema:
              type: array
              items:
                $ref: "#/components/schemas/Product"
        required: true
      responses:
        "200":
          description: OK
          content:
            application/json: {}
        "400":
          description: Bad Request
      summary: Add Multiple
      tags:
      - Product Resource
  /products/range:
    get:
      parameters:
      - name: end
        in: query
        schema:
          type: integer
          format: int32
      - name: start
        in: query
        schema:
          type: integer
          format: int32
      responses:
        "200":
          description: OK
          content:
            application/json: {}
      summary: Get Range
      tags:
      - Product Resource
  /products/sorted:
    get:
      responses:
        "200":
          description: OK
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/Product"
      summary: Get Sorted By Price
      tags:
      - Product Resource
  /products/test/cleanup:
    post:
      responses:
        "201":
          description: Created
      summary: Cleanup
      tags:
      - Product Resource
  /products/{id}:
    put:
      parameters:
      - name: id
        in: path
        required: true
        schema:
          type: integer
          format: int32
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/ProductDTO"
        required: true
      responses:
        "200":
          description: OK
          content:
            application/json: {}
        "400":
          description: Bad Request
      summary: Update
      tags:
      - Product Resource
    get:
      parameters:
      - name: id
        in: path
        required: true
        schema:
          type: integer
          format: int32
      responses:
        "200":
          description: OK
          content:
            application/json: {}
      summary: Get By Id
      tags:
      - Product Resource
    delete:
      parameters:
      - name: id
        in: path
        required: true
        schema:
          type: integer
          format: int32
      responses:
        "200":
          description: OK
          content:
            application/json: {}
      summary: Delete
      tags:
      - Product Resource
  /products/{id}/stock:
    get:
      parameters:
      - name: id
        in: path
        required: true
        schema:
          type: integer
          format: int32
      - name: count
        in: query
        schema:
          type: integer
          format: int32
      responses:
        "200":
          description: OK
          content:
            application/json: {}
      summary: Check Stock
      tags:
      - Product Resource
info:
  title: Product Service API
  version: 1.0.0
  description: API for managing products
